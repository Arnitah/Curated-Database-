{
  "name": "curated-database",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/build.mjs --check",
    "build": "node scripts/build.mjs",
    "verdicts": "node scripts/check-verdicts.mjs",
    "verdicts:update": "node scripts/check-verdicts.mjs --update",
    "test:engine": "node apps/ingredient-intelligence/tests/smoke.test.mjs && node apps/ingredient-intelligence/tests/clay-shaped.test.mjs",
    "test:clay": "node --test --test-concurrency=1 tests/clay/*.test.mjs",
    "test:ci": "npm run test:engine && npm run test:clay"
  },
  "devDependencies": {
    "playwright": "1.49.1"
  }
}
