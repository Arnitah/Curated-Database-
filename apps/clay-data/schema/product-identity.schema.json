{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:clay-data:product-identity",
  "title": "Clay v2 product identity",
  "description": "What a product is, kept apart from the copy a person owns. Migrated (part identity) or user-created.",
  "type": "object",
  "properties": {
    "entityType": {
      "type": "string",
      "const": "productIdentity"
    },
    "schemaVersion": {
      "$ref": "urn:clay-data:common#/$defs/schemaVersion"
    },
    "id": {
      "$ref": "urn:clay-data:common#/$defs/entityId"
    },
    "idKind": {
      "$ref": "urn:clay-data:common#/$defs/idKind"
    },
    "createdAt": {
      "$ref": "urn:clay-data:common#/$defs/createdAt"
    },
    "clock": {
      "$ref": "urn:clay-data:common#/$defs/clock"
    },
    "origin": {
      "$ref": "urn:clay-data:common#/$defs/origin"
    },
    "contentHash": {
      "$ref": "urn:clay-data:common#/$defs/contentHash"
    },
    "brand": {
      "$ref": "urn:clay-data:common#/$defs/stringState"
    },
    "productName": {
      "$ref": "urn:clay-data:common#/$defs/stringState"
    },
    "variant": {
      "$ref": "urn:clay-data:common#/$defs/stringState"
    },
    "format": {
      "$ref": "urn:clay-data:common#/$defs/stringState"
    },
    "size": {
      "$ref": "urn:clay-data:common#/$defs/stringState"
    },
    "category": {
      "$ref": "urn:clay-data:common#/$defs/stringState"
    },
    "visibility": {
      "type": "string",
      "const": "private"
    }
  },
  "required": [
    "entityType",
    "schemaVersion",
    "id",
    "idKind",
    "createdAt",
    "clock",
    "origin",
    "contentHash",
    "brand",
    "productName",
    "variant",
    "format",
    "size",
    "category",
    "visibility"
  ],
  "additionalProperties": false
}
