{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:clay-data:ingredient-observation",
  "title": "Clay v2 ingredient observation",
  "description": "One immutable, bottle-specific ingredient-list observation. Migrated (part observation, source legacy_unspecified) or user-created.",
  "type": "object",
  "properties": {
    "entityType": {
      "type": "string",
      "const": "ingredientObservation"
    },
    "schemaVersion": {
      "$ref": "urn:clay-data:common#/$defs/schemaVersion"
    },
    "id": {
      "$ref": "urn:clay-data:common#/$defs/entityId"
    },
    "idKind": {
      "$ref": "urn:clay-data:common#/$defs/idKind"
    },
    "createdAt": {
      "$ref": "urn:clay-data:common#/$defs/createdAt"
    },
    "clock": {
      "$ref": "urn:clay-data:common#/$defs/clock"
    },
    "origin": {
      "$ref": "urn:clay-data:common#/$defs/origin"
    },
    "contentHash": {
      "$ref": "urn:clay-data:common#/$defs/contentHash"
    },
    "ownedItemRef": {
      "$ref": "urn:clay-data:common#/$defs/entityId"
    },
    "rawText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "sourceKind": {
      "$ref": "urn:clay-data:common#/$defs/sourceKind"
    },
    "capturedOn": {
      "$ref": "urn:clay-data:common#/$defs/stringState"
    },
    "market": {
      "$ref": "urn:clay-data:common#/$defs/stringState"
    },
    "completeness": {
      "$ref": "urn:clay-data:common#/$defs/stringState"
    },
    "transcriptionStatus": {
      "$ref": "urn:clay-data:common#/$defs/stringState"
    }
  },
  "required": [
    "entityType",
    "schemaVersion",
    "id",
    "idKind",
    "createdAt",
    "clock",
    "origin",
    "contentHash",
    "ownedItemRef",
    "rawText",
    "sourceKind",
    "capturedOn",
    "market",
    "completeness",
    "transcriptionStatus"
  ],
  "additionalProperties": false
}
